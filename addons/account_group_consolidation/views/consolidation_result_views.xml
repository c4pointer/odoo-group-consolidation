<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consolidation_result_pivot" model="ir.ui.view">
        <field name="name">account.consolidation.result.pivot</field>
        <field name="model">account.consolidation.result</field>
        <field name="arch" type="xml">
            <pivot string="Consolidated report" disable_linking="True">
                <field name="section" type="row"/>
                <field name="line_id" type="row"/>
                <field name="column_company_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_consolidation_result_list" model="ir.ui.view">
        <field name="name">account.consolidation.result.list</field>
        <field name="model">account.consolidation.result</field>
        <field name="arch" type="xml">
            <list create="False" edit="False">
                <field name="run_id"/>
                <field name="section"/>
                <field name="line_id"/>
                <field name="code" optional="hide"/>
                <field name="column_company_id"/>
                <field name="local_amount"/>
                <field name="local_amount_ytd" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="amount_ytd" optional="show" sum="Total"/>
                <field name="group_currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_consolidation_result_search" model="ir.ui.view">
        <field name="name">account.consolidation.result.search</field>
        <field name="model">account.consolidation.result</field>
        <field name="arch" type="xml">
            <search>
                <field name="run_id"/>
                <field name="line_id"/>
                <field name="column_company_id"/>
                <filter name="profit_and_loss" string="Profit and loss" domain="[('section', '=', 'pl')]"/>
                <filter name="balance_sheet" string="Balance sheet" domain="[('section', '!=', 'pl')]"/>
                <separator/>
                <filter name="eliminations" string="Eliminations" domain="[('is_elimination', '=', True)]"/>
                <group>
                    <filter name="group_by_line" string="Line" context="{'group_by': 'line_id'}"/>
                    <filter name="group_by_column" string="Column" context="{'group_by': 'column_company_id'}"/>
                    <filter name="group_by_run" string="Run" context="{'group_by': 'run_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_consolidation_result" model="ir.actions.act_window">
        <field name="name">Consolidated report</field>
        <field name="res_model">account.consolidation.result</field>
        <field name="view_mode">pivot,list</field>
        <field name="help" type="html">
            <p>Run a consolidation to see the group profit and loss and balance sheet.
               Columns are the companies and the eliminations; the total is the group.</p>
        </field>
    </record>

    <!-- The menu opens one month, the latest closed, never a total over months. -->
    <record id="action_open_latest_report" model="ir.actions.server">
        <field name="name">Consolidated report</field>
        <field name="model_id" ref="model_account_consolidation_run"/>
        <field name="state">code</field>
        <!-- With groups set, Odoo checks membership instead of write access on runs. -->
        <field name="group_ids" eval="[Command.link(ref('account.group_account_readonly')), Command.link(ref('account.group_account_manager'))]"/>
        <field name="code">action = model.action_open_latest_report()</field>
    </record>
</odoo>
